index 0000000..9f8e7d6
--- /dev/null
+++ b/src/billing/retry.py
@@ -0,0 +1,9 @@
+import time
+
+def charge_with_retry(gateway, amount):
+    for attempt in range(5):
+        try:
+            return gateway.charge(amount)
+        except Exception:
+            pass
+    return None
