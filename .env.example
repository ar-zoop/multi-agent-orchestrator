OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Public demo guards. SPEND_CAP_USD=0 (or "off") disables the cap.
SPEND_CAP_USD=5.00
SPEND_CAP_WINDOW_SECONDS=86400
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set API_KEY to require an X-API-Key header on every endpoint that spends money.
# API_KEY=

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=loan_bank_db
POSTGRES_STATEMENT_TIMEOUT_MS=10000
